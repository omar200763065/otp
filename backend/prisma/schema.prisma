datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String
  role          String     @default("OPERATOR") // ADMIN, OPERATOR, VIEWER
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  auditLogs     AuditLog[]

  @@map("users")
}

model Tenant {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  companyName   String?
  status        String            @default("ACTIVE")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  apps          App[]
  whatsappConfigs WhatsAppConfig[]
  webhooks      WebhookEndpoint[]

  @@map("tenants")
}

model App {
  id            String           @id @default(uuid())
  tenantId      String
  name          String
  slug          String           @unique
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  otpTransactions OtpTransaction[]

  @@map("apps")
}

model ApiKey {
  id            String    @id @default(uuid())
  appId         String
  name          String
  keyPrefix     String    // e.g. otp_live_a1b2 or otp_test_x9y8
  keyHash       String    @unique
  type          String    @default("LIVE") // LIVE, TEST
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  app           App       @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model OtpTransaction {
  id                String    @id @default(uuid())
  appId             String
  phoneNumber       String    // E.164 format, e.g. +966500000000
  channel           String    @default("WHATSAPP") // WHATSAPP, SMS, EMAIL
  otpHash           String    // HMAC/SHA-256 hashed OTP code
  status            String    @default("PENDING") // PENDING, VERIFIED, EXPIRED, CANCELLED, FAILED
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  resendCount       Int       @default(0)
  expiresAt         DateTime
  verifiedAt        DateTime?
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  meta              String?   // JSON string
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  app               App       @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([phoneNumber, status])
  @@index([appId, createdAt])
  @@map("otp_transactions")
}

model WhatsAppConfig {
  id                String   @id @default(uuid())
  tenantId          String
  phoneNumberId     String
  businessAccountId String
  accessToken       String
  senderPhoneNumber String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates         MessageTemplate[]

  @@map("whatsapp_configs")
}

model MessageTemplate {
  id               String         @id @default(uuid())
  whatsappConfigId String
  name             String         // e.g. "otp_verification_code"
  language         String         @default("ar")
  bodyText         String         
  category         String         @default("AUTHENTICATION")
  status           String         @default("APPROVED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  whatsappConfig   WhatsAppConfig @relation(fields: [whatsappConfigId], references: [id], onDelete: Cascade)

  @@map("message_templates")
}

model IpRule {
  id          String     @id @default(uuid())
  type        String     @default("BLACKLIST") // BLACKLIST, WHITELIST
  value       String     // IP, CIDR, or Phone Country Prefix (e.g. +966 or 192.168.1.1)
  reason      String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("ip_rules")
}

model WebhookEndpoint {
  id          String       @id @default(uuid())
  tenantId    String
  url         String
  secret      String
  events      String       @default("otp.sent,otp.verified") // Comma-separated events
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]

  @@map("webhook_endpoints")
}

model WebhookLog {
  id               String          @id @default(uuid())
  webhookEndpointId String
  event            String
  payload          String          // JSON string
  responseCode     Int?
  responseBody     String?
  attempts         Int             @default(1)
  isSuccess        Boolean         @default(false)
  createdAt        DateTime        @default(now())

  webhookEndpoint  WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  action      String   
  resource    String   
  details     String?  // JSON string
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
