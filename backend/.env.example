# Server Environment Configuration
PORT=3000
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://otp_user:SuperSecretPassword123!@localhost:5432/otp_platform_db?schema=public"

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets for Admin Dashboard
JWT_SECRET=super_secret_jwt_key_enterprise_otp_2026_change_me!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_enterprise_otp_2026!
JWT_REFRESH_EXPIRES_IN=7d

# OTP Cryptographic Hash Salt
OTP_HMAC_SECRET=super_secret_otp_hmac_hash_key_2026!
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# WhatsApp Business Cloud API Defaults
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG...YOUR_ACCESS_TOKEN_HERE
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_DEFAULT_TEMPLATE=otp_verification_code

# Webhook Security Secret
WEBHOOK_SIGNATURE_SECRET=webhook_secret_signature_key_2026!

# Admin Superuser Initial Seed Credentials
INITIAL_ADMIN_EMAIL=admin@otpsaas.com
INITIAL_ADMIN_PASSWORD=AdminPassword123!
