{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts?__url=/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.ts?__url=/admin/$1"
    },
    {
      "src": "/otp/(.*)",
      "dest": "/api/index.ts?__url=/otp/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}